[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_8xahp"]
size = Vector2(720, 920)
expression = "vec2 new_uv = vec2(0, 0);
float dist;

for (int i = 0; i < colors_count; i++) {
	float u = (float(i) + 0.5) / float(colors_count);
	float v = 0.5;
	vec2 uv = vec2(u, v);
	vec4 original_palette_color = texture(original_palette, uv);
	dist = distance(color, original_palette_color);
	
	if (dist == 0.0) {
		new_uv = uv;
		break;
	}
}

if (dist == 0.0) {
	new_color = texture(new_palette, new_uv);
}
else {
	new_color = color;
}

;"

