[gd_resource type="ShaderMaterial" format=3 uid="uid://dp13wgui83q7g"]

[ext_resource type="Texture2D" uid="uid://l53dgjtb8j54" path="res://assets/palette/palette_plant.png" id="2_8todn"]

[sub_resource type="Shader" id="Shader_m6bcs"]
code = "shader_type canvas_item;
#include \"palette_inc.gdshaderinc\"
uniform sampler2D original_palettes;
uniform sampler2D new_palettes;
uniform int colors_counts;

void vertex() {
	// Called for every vertex the material is visible on.
	int seed = int((UV.y * 192.0) / 32.0) + int((UV.x * 128.0) / 32.0);
	float balence = cos(TIME + float(seed));
	//int((UV.y * 192.0) / 32);
	VERTEX.x += balence * ((32.0 - float(int(UV.y * 192.0) % 32)) / 4.0);
}

void fragment() {
	// Called for every pixel the material is visible on.
	COLOR = sawp(original_palettes, new_palettes, colors_counts, COLOR);
}

//void light() {
//	// Called for every pixel for every light affecting the CanvasItem.
//	// Uncomment to replace the default light processing function with this one.
//}
"

[resource]
shader = SubResource("Shader_m6bcs")
shader_parameter/original_palettes = ExtResource("2_8todn")
shader_parameter/new_palettes = ExtResource("2_8todn")
shader_parameter/colors_counts = 12
