vec2 new_uv2 = vec2(0, 0);
new_uv2[0] = float(int((tuv.x * 96.0)) % 32) / 32.0;
new_uv2[1] = float(int((tuv.y * 192.0)) % 32) / 32.0;
//new_uv2[0] = 1.0;
//new_uv2[1] = 1.0;
if (dist == 0.0) {
	if (new_uv2[0] <= 0.5) {
		//new_uv2[0] = 0.5;
	}
	if (new_uv2[1] >= 0.5) {
		new_uv2[1] = 0.5;
	}
	new_color = vec4(new_uv2[0], new_uv2[1], 0.5 + texture(new_palette, new_uv)[2] / 2.0, 1.0);
	//new_color = texture(new_palette, new_uv);
}
else {
	new_color = color;
}

