[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_8xahp"]
size = Vector2(720, 600)
expression = "vec2 new_uv = vec2(0, 0);
float dist;

for (int i = 0; i < colors_count; i++) {
	float u = (float(i) + 0.5) / float(colors_count);
	float v = 0.5;
	vec2 uv = vec2(u, v);
	vec4 original_palette_color = texture(original_palette, uv);
	dist = distance(color, original_palette_color);
	
	if (dist == 0.0) {
		new_uv = uv;
		break;
	}
}

if (dist == 0.0) {
	new_color = texture(new_palette, new_uv);
}
else {
	new_color = color;
}

;"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_k0qfg"]
size = Vector2(1040, 1540)
expression = "vec2 new_uv = vec2(0, 0);
float dist;

for (int i = 0; i < colors_count; i++) {
	float u = (float(i) + 0.5) / float(colors_count);
	float v = 0.5;
	vec2 uv = vec2(u, v);
	vec4 original_palette_color = texture(original_palette, uv);
	dist = distance(color, original_palette_color);
	
	if (dist == 0.0) {
		new_uv = uv;
		break;
	}
}
vec2 new_uv2 = vec2(0, 0);
new_uv2[0] = float(int((tuv.x * size.x)) % 32) / 32.0;
new_uv2[1] = float(int((tuv.y * size.y)) % 32) / 32.0;
//new_uv2 = tuv;
if (rotate[0] == 1.0) {
	float tmp = new_uv2[0];
	new_uv2[0] = new_uv2[1];
	new_uv2[1] = tmp;
	//new_uv2[0] = -new_uv2[0];
}

if (dist == 0.0) {
	if (side4[0] == 1.0) {
		if (new_uv2[0] <= 0.5) {
			new_uv2[0] = 0.5 * (1.0 - new_uv2[0]) + new_uv2[0] * (new_uv2[0]);
		}
	}
	if (side4[1] == 1.0) {
		if (new_uv2[1] <= 0.5) {
			new_uv2[1] = 0.5 * (1.0 - new_uv2[1]) + new_uv2[1] * (new_uv2[1]);
		}
	}
	if (side4[2] == 1.0) {
		if (new_uv2[0] >= 0.5) {
			new_uv2[0] = 0.5 * (new_uv2[0]) + new_uv2[0] * (1.0 - new_uv2[0]);
		}
	}
	if (side4[3] == 1.0) {
		if (new_uv2[1] >= 0.5) {
			new_uv2[1] = 0.5 * (new_uv2[1]) + new_uv2[1] * (1.0 - new_uv2[1]);
		}
	}
	if (rotate[0] == 1.0) {
		//float tmp = new_uv2[0];
		//new_uv2[0] = new_uv2[1];
		//new_uv2[1] = tmp;
		//new_uv2[0] = -new_uv2[0];
	}
	if (rotate[1] == 1.0) {
		new_uv2[0] = -new_uv2[0];
	}
	if (rotate[2] == 1.0) {
		new_uv2[1] = -new_uv2[1];
	}
	if (no_hight) {
		new_color = vec4(0.5 + texture(new_palette, new_uv)[0] / 2.0, 0.5 + texture(new_palette, new_uv)[0] / 2.0, 0.5 + texture(new_palette, new_uv)[0] / 2.0, 1.0);
	}
	else {
		new_color = vec4(new_uv2[0] + rotate[1], 1.0 - new_uv2[1] - rotate[2], 0.5 + texture(new_palette, new_uv)[0] / 2.0, 1.0);
	}
	
}
else {
	new_color = color;
}
//new_color = vec4(tuv, 0.5 + texture(new_palette, new_uv)[0] / 2.0, 1.0);
//new_color = color
;"

