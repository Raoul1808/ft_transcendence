FROM rust:1.99-alpine AS watchexec

RUN apk --no-cache add musl-dev
RUN cargo install watchexec-cli

FROM rust:1.99-alpine AS build

COPY --from=watchexec /usr/local/cargo/bin/watchexec /usr/local/cargo/bin/watchexec
RUN apk --no-cache add musl-dev ca-certificates bash

WORKDIR /app

EXPOSE 8080
ENTRYPOINT ["watchexec", "-w", "src", "-w", "static", "-r", "--", "cargo", "run"]
